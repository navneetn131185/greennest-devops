# Copy this file to .env and replace every value before running the stack.
# Never commit .env or production credentials.
DB_ROOT_PASSWORD=change_me_mysql_root_password
DB_NAME=greennest
DB_USERNAME=greennest
DB_PASSWORD=change_me_mysql_app_password
DB_URL=jdbc:mysql://mysql:3306/greennest?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DDL_AUTO=update
SHOW_SQL=false
APP_CORS_ALLOWED_ORIGIN=http://localhost:5173
JWT_SECRET=change_me_with_a_long_random_value_at_least_32_characters
JWT_EXPIRATION_MS=86400000
APP_ADMIN_EMAIL=admin@example.com
APP_ADMIN_PASSWORD=change_me_admin_password
VITE_API_BASE_URL=http://localhost:8080
GRAFANA_ADMIN_PASSWORD=change_me_grafana_password
